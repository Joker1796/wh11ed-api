# wh11ed-api — environment variables. Copy to .env for `npm run dev` outside docker.
# The local stand (docker-compose.yml) sets all of these itself — you need no .env for it.
# In production they live in the server's own .env, never in git.

# --- Database ---
DATABASE_URL=postgres://wh:wh@localhost:5433/wh

# --- App ---
# Comma-separated list of allowed CORS origins (the SPA origins).
ALLOWED_ORIGINS=http://localhost:5173
# Public base URL of THIS api (used to build OAuth redirect URIs).
API_BASE_URL=http://localhost:8787
# Where to send the browser back to after a successful login (a thin SPA route).
APP_AFTER_LOGIN_URL=http://localhost:5173/tracker/auth-callback
# Cookie Domain for the refresh cookie. Empty for localhost; api.wh-rules.ru in prod.
COOKIE_DOMAIN=

# --- Session / JWT ---
# 32+ byte random string. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=dev-only-insecure-key-change-me-0000000000000000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- OAuth: Yandex ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Stand only: point sign-in at stand/fake-oauth.mjs (`node stand/fake-oauth.mjs`) instead of Yandex.
# OAUTH_YANDEX_AUTHORIZE_URL=http://localhost:8790/authorize
# OAUTH_YANDEX_SERVER_URL=http://localhost:8790
# OAUTH_YANDEX_INFO_URL=http://localhost:8790/info

# --- Bug-report mail (optional: inert unless SMTP_HOST and both addresses are set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FEEDBACK_MAIL_FROM=
FEEDBACK_MAIL_TO=
