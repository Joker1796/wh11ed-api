{
  "name": "wh11ed-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Backend for WH Rules (wh-rules.ru): sign-in, cloud backup of games, army lists and marks, live shared games. Node + Hono + PostgreSQL.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx src/server.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "test": "node --experimental-test-module-mocks --import tsx --test test/*.test.ts",
    "test:db": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 test/db/*.test.ts",
    "seed": "node --env-file-if-exists=.env --import tsx stand/seed.ts",
    "feedback:list": "node --env-file-if-exists=.env --import tsx scripts/feedback-list.ts",
    "feedback:delete": "node --env-file-if-exists=.env --import tsx scripts/feedback-delete.ts",
    "errors:list": "node --env-file-if-exists=.env --import tsx scripts/errors-list.ts",
    "errors:resolve": "node --env-file-if-exists=.env --import tsx scripts/errors-resolve.ts",
    "errors:digest": "node --env-file-if-exists=.env --import tsx scripts/errors-digest.ts",
    "changelog:publish": "node --env-file-if-exists=.env --import tsx scripts/changelog-publish.ts",
    "users:count": "node --env-file-if-exists=.env --import tsx scripts/users-count.ts",
    "dev:jwt": "node --env-file-if-exists=.env --import tsx scripts/dev-jwt.ts",
    "stand": "docker compose up -d --wait --remove-orphans",
    "stand:seed": "docker compose exec api node --import tsx stand/seed.ts",
    "stand:reset": "docker compose exec api node --import tsx stand/seed.ts --reset",
    "stand:test": "docker compose exec api node --import tsx --test --test-concurrency=1 test/db/*.test.ts",
    "stand:psql": "docker compose exec postgres psql -U wh -d wh",
    "stand:logs": "docker compose logs -f api",
    "stand:down": "docker compose down"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "nodemailer": "^10.2.0",
    "postgres": "^3.4.9",
    "source-map-js": "^1.2.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/swagger-ui": "^0.6.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2"
  }
}
