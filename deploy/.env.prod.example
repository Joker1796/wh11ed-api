# /opt/wh-rules/.env on the server — chmod 600, never in git. Every value the API reads in
# production; the compose file adds DATABASE_URL and PORT itself.

# --- Database ---
POSTGRES_PASSWORD=            # openssl rand -base64 32 | tr -d '/+='

# --- TLS ---
ACME_EMAIL=                   # Let's Encrypt account mail: expiry warnings land here

# --- App ---
ALLOWED_ORIGINS=https://wh-rules.ru,https://beta.wh-rules.ru
API_BASE_URL=https://api.wh-rules.ru
APP_AFTER_LOGIN_URL=https://wh-rules.ru/tracker/auth-callback
COOKIE_DOMAIN=api.wh-rules.ru

# --- Session / JWT ---
JWT_SIGNING_KEY=              # openssl rand -base64 48 — a NEW key: old sessions end, players sign in once
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- OAuth: Yandex (the same app; its redirect URI stays https://api.wh-rules.ru/auth/yandex/callback) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Bug-report mail (optional) ---
# Production: a send-only app password of wh-rules@mail.ru. Selectel blocks outgoing 25/465/587 by
# default (anti-spam), so Mail.ru is reached on 2525 with STARTTLS (SMTP_SECURE=false).
SMTP_HOST=smtp.mail.ru
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=wh-rules@mail.ru
SMTP_PASS=
FEEDBACK_MAIL_FROM=WH Rules <wh-rules@mail.ru>
FEEDBACK_MAIL_TO=
